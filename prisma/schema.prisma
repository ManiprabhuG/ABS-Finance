generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(uuid())
  username     String     @unique
  passwordHash String
  name         String
  email        String?
  role         String     @default("ADMIN") // SUPER_ADMIN, ADMIN, ACCOUNTANT, COLLECTION_OFFICER, LOAN_OFFICER, VIEWER
  branch       String     @default("Main Branch")
  status       String     @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  collectionsRecorded Collection[]
  auditLogs           AuditLog[]
}

model Customer {
  id              String       @id @default(uuid())
  customerId      String       @unique // e.g. CUST-1001
  name            String
  mobile          String       @unique
  aadhaar         String       @unique // BUG-006 FIX: Aadhaar must be unique per regulatory compliance
  pan             String?
  address         String
  email           String?
  occupation      String?
  nomineeName     String?
  nomineeRelation String?
  nomineeMobile   String?
  photoUrl        String?      @db.LongText
  remarks         String?
  riskScore       Float        @default(85.0)
  riskCategory    String       @default("LOW") // LOW, MEDIUM, HIGH, BLACKLISTED
  isBlacklisted   Boolean      @default(false)
  riskFactors     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  loans            Loan[]
  collections      Collection[]
  documents        Document[]
  riskLogs         CustomerRiskLog[]
  fraudAlerts      FraudAlert[]
  collaterals      CollateralVault[]
  fieldCollections FieldCollection[]
  notifications    NotificationLog[]
  settlements      LoanSettlement[]
  taxInvoices      TaxInvoice[]
}

model Loan {
  id                 String          @id @default(uuid())
  loanNumber         String          @unique // e.g. LN-2026-001
  customerId         String
  loanType           String          // MORTGAGE, NORMAL, CUSTOM
  principalAmount    Float
  interestType       String          @default("FLAT") // FLAT, REDUCING, MANUAL
  interestRate       Float           // Annual %
  tenureMonths       Int             @default(12)
  installmentType    String          @default("MONTHLY") // DAILY, WEEKLY, MONTHLY
  tenureValue        Int             @default(12)
  totalInterestAmount Float?
  installmentAmount  Float?
  loanDate           DateTime        @default(now())
  status             String          @default("PENDING") // PENDING, APPROVED, DISBURSED, ACTIVE, OVERDUE, CLOSED, REJECTED
  npaCategory        String          @default("STANDARD") // STANDARD, SUBSTANDARD, DOUBTFUL, NPA
  npaDays            Int             @default(0)
  outstandingBalance Float
  disbursedFrom      String?         // CASH or BANK
  bankAccountId      String?
  notes              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  mortgageDetail   MortgageDetail?
  collections      Collection[]
  ledgerEntries    LedgerEntry[]
  documents        Document[]
  npaRecoveries    NPARecovery[]
  legalCases       LegalCase[]
  fraudAlerts      FraudAlert[]
  collaterals      CollateralVault[]
  fieldCollections FieldCollection[]
  notifications    NotificationLog[]
  settlements      LoanSettlement[]
}

model MortgageDetail {
  id               String   @id @default(uuid())
  loanId           String   @unique
  assetType        String   // PROPERTY, GOLD, VEHICLE, SHARES, OTHER
  assetDescription String
  estimatedValue   Float
  marketValue      Float
  ltvPercentage    Float
  documentUrls     String?  // JSON array string
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)
}

model InterestSlab {
  id           String   @id @default(uuid())
  name         String
  fromAmount   Float
  toAmount     Float
  interestRate Float
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model LTVInterestSlab {
  id           String   @id @default(uuid())
  ltvRange     String   // e.g. "0-40%"
  minLtv       Float
  maxLtv       Float
  interestRate Float
  loanCategory String   @default("MORTGAGE")
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Collection {
  id             String   @id @default(uuid())
  collectionId   String   @unique // e.g. COL-1001
  loanId         String
  customerId     String
  collectionDate DateTime @default(now())
  amountReceived Float
  principalPaid  Float
  interestPaid   Float
  penaltyPaid    Float    @default(0)
  paymentMode    String   // CASH, BANK_TRANSFER, UPI, CHEQUE
  bankAccountId  String?
  referenceNo    String?
  recordedById   String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  loan       Loan        @relation(fields: [loanId], references: [id], onDelete: Cascade)
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  recordedBy User?       @relation(fields: [recordedById], references: [id])
  ledgerEntries LedgerEntry[]
}

model BankAccount {
  id             String   @id @default(uuid())
  accountName    String
  accountNumber  String   @unique
  bankName       String
  branch         String
  ifsc           String
  openingBalance Float
  currentBalance Float
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  ledgerEntries LedgerEntry[]
}

model CashAccount {
  id             String   @id @default("cash-master")
  name           String   @default("Cash In Hand")
  currentBalance Float    @default(0)
  updatedAt      DateTime @updatedAt
}

model LedgerEntry {
  id              String   @id @default(uuid())
  ledgerId        String   @unique // e.g. LEDG-10001
  date            DateTime @default(now())
  transactionType String   // DISBURSEMENT, COLLECTION, INCOME, EXPENSE, BANK_TRANSFER, ADJUSTMENT
  referenceNo     String?
  debit           Float    @default(0)
  credit          Float    @default(0)
  balanceAfter    Float
  bankAccountId   String?
  isCash          Boolean  @default(false)
  remarks         String
  loanId          String?
  collectionId    String?
  incomeId        String?
  expenseId       String?
  createdAt       DateTime @default(now())

  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id])
  loan        Loan?        @relation(fields: [loanId], references: [id])
  collection  Collection?  @relation(fields: [collectionId], references: [id])
  income      Income?      @relation(fields: [incomeId], references: [id]) // BUG-007 FIX
  expense     Expense?     @relation(fields: [expenseId], references: [id]) // BUG-007 FIX
}

model Income {
  id            String   @id @default(uuid())
  incomeNo      String   @unique // e.g. INC-1001
  category      String   // PROCESSING_FEE, DOCUMENTATION_FEE, SERVICE_CHARGE, OTHER
  amount        Float
  date          DateTime @default(now())
  paymentMode   String   // CASH, BANK_TRANSFER, UPI, CHEQUE
  bankAccountId String?
  isCash        Boolean  @default(true)
  referenceNo   String?
  remarks       String?
  createdAt     DateTime @default(now())

  ledgerEntries LedgerEntry[] // BUG-007 FIX
}

model Expense {
  id            String   @id @default(uuid())
  expenseNo     String   @unique // e.g. EXP-1001
  category      String   // OFFICE_RENT, SALARY, ELECTRICITY, MAINTENANCE, MISC
  amount        Float
  date          DateTime @default(now())
  paymentMode   String   // CASH, BANK_TRANSFER, UPI, CHEQUE
  bankAccountId String?
  isCash        Boolean  @default(true)
  referenceNo   String?
  remarks       String?
  createdAt     DateTime @default(now())

  ledgerEntries LedgerEntry[] // BUG-007 FIX
}

model FundTransfer {
  id              String   @id @default(uuid())
  transferNo      String   @unique // e.g. TRSF-1001
  date            DateTime @default(now())
  amount          Float
  fromAccountType String   // BANK or CASH
  fromAccountId   String?  // Bank Account ID if BANK
  toAccountType   String   // BANK or CASH
  toAccountId     String?  // Bank Account ID if BANK
  referenceNo     String?
  remarks         String?
  createdAt       DateTime @default(now())
}

model Document {
  id            String    @id @default(uuid())
  title         String
  category      String    // AADHAAR, PAN, PROPERTY_DOC, LOAN_AGREEMENT, MORTGAGE_DOC, PHOTO, OTHER
  fileUrl       String    @db.LongText
  isEncrypted   Boolean   @default(false)
  watermarkText String?
  expiryDate    DateTime?
  viewCount     Int       @default(0)
  customerId    String?
  loanId        String?
  createdAt     DateTime  @default(now())

  customer Customer? @relation(fields: [customerId], references: [id])
  loan     Loan?     @relation(fields: [loanId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  username  String
  action    String   // CREATE, UPDATE, DELETE, LOGIN, LOGOUT, APPROVE, DISBURSE
  module    String   // CUSTOMER, LOAN, COLLECTION, FINANCE, SETTINGS, USER
  details   String
  ipAddress String   @default("127.0.0.1")
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model SystemSettings {
  id               String @id @default("default-settings")
  companyName      String @default("ABS Finance Management Ltd.")
  logoUrl          String @default("/logo.png")
  address          String @default("123 Financial District, Tech City")
  gstNumber        String @default("33AAAAA0000A1Z5")
  contactPhone     String @default("+91 98765 43210")
  contactEmail     String @default("contact@absfinance.com")
  loanPrefix       String @default("LN")
  receiptPrefix    String @default("REC")
  defaultPenalty   Float  @default(2.0)
  gracePeriodDays  Int    @default(5)
  financialYear    String @default("2026-2027")
  currencySymbol   String @default("₹")
}

model CustomerRiskLog {
  id                 String   @id @default(uuid())
  customerId         String
  riskScore          Float
  riskCategory       String   // LOW, MEDIUM, HIGH, BLACKLISTED
  verificationScores String?  // JSON breakdown
  riskFactors        String?
  evaluatedAt        DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model FraudAlert {
  id          String   @id @default(uuid())
  type        String   // DUPLICATE_IDENTIFIER, ABNORMAL_COLLECTION, SUSPICIOUS_TRANSFER, FAKE_CONTACT
  severity    String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  customerId  String?
  loanId      String?
  details     String
  status      String   @default("OPEN") // OPEN, INVESTIGATING, RESOLVED, DISMISSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  loan     Loan?     @relation(fields: [loanId], references: [id], onDelete: SetNull)
}

model NPARecovery {
  id           String    @id @default(uuid())
  loanId       String
  npaCategory  String    // STANDARD, SUBSTANDARD, DOUBTFUL, NPA
  daysOverdue  Int
  actionType   String    // CALL, VISIT, NOTICE, LEGAL
  officerName  String
  actionDate   DateTime  @default(now())
  notes        String?
  nextFollowUp DateTime?

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)
}

model LegalCase {
  id          String    @id @default(uuid())
  loanId      String
  caseNumber  String    @unique
  courtName   String
  advocate    String
  filingDate  DateTime  @default(now())
  hearingDate DateTime?
  status      String    @default("FILED") // FILED, IN_PROGRESS, NOTICE_SENT, JUDGMENT_DECREE, RECOVERED, CLOSED
  claimAmount Float
  remarks     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)
}

model UserDeviceLog {
  id         String   @id @default(uuid())
  userId     String
  ipAddress  String
  userAgent  String
  deviceType String   @default("DESKTOP")
  location   String?
  loginTime  DateTime @default(now())
}

model CollateralVault {
  id               String    @id @default(uuid())
  loanId           String
  customerId       String?
  assetType        String    // GOLD, PROPERTY_DEED, VEHICLE_RC, FIXED_DEPOSIT, OTHER
  assetDescription String
  itemCount        Int       @default(1)
  grossWeight      Float?    // Grams for gold
  netWeight        Float?    // Grams for gold
  purityKarat      String?   // "22K", "24K"
  estimatedValue   Float
  marketValue      Float
  vaultNumber      String    @default("VAULT-01")
  lockerNumber     String    // e.g. "LOCKER-B-14"
  packetNumber     String    @unique // e.g. "PKT-2026-089"
  sealNumber       String    // e.g. "SEAL-99214"
  status           String    @default("IN_VAULT") // IN_VAULT, AUDIT_INSPECTED, RELEASED, AUCTIONED
  depositDate      DateTime  @default(now())
  releaseDate      DateTime?
  custodianName    String    @default("Senior Vault Officer")
  custodyLogs      String?   @db.LongText // JSON tracking history
  remarks          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  loan     Loan?     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
}

model FieldCollection {
  id                String   @id @default(uuid())
  receiptNo         String   @unique // e.g. "FLD-REC-1001"
  officerId         String?
  officerName       String
  customerId        String
  loanId            String
  amount            Float
  paymentMode       String   @default("CASH") // CASH, UPI_QR, CHEQUE
  upiRef            String?
  latitude          Float?
  longitude         Float?
  locationAddress   String?
  customerSignature String?  @db.LongText
  status            String   @default("SYNCED") // SYNCED, PENDING_AUDIT
  notes             String?
  collectedAt       DateTime @default(now())
  createdAt         DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  loan     Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
}

model NotificationLog {
  id              String    @id @default(uuid())
  customerId      String?
  loanId          String?
  recipientName   String
  recipientMobile String
  channel         String    @default("WHATSAPP") // WHATSAPP, SMS, EMAIL
  templateType    String    // EMI_DUE_REMINDER, PAYMENT_RECEIPT, OVERDUE_PENALTY, LEGAL_NOTICE, OTS_OFFER
  messageContent  String    @db.LongText
  status          String    @default("DELIVERED") // SENT, DELIVERED, READ, FAILED
  sentBy          String    @default("SYSTEM_AUTOBOT")
  deliveredAt     DateTime?
  createdAt       DateTime  @default(now())

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  loan     Loan?     @relation(fields: [loanId], references: [id], onDelete: SetNull)
}

model LoanSettlement {
  id                    String    @id @default(uuid())
  settlementNo          String    @unique // e.g. "OTS-2026-001"
  loanId                String
  customerId            String
  principalOutstanding Float
  interestAccrued       Float
  penalCharges          Float
  foreclosureFee        Float     @default(0)
  waiverDiscount        Float     @default(0)
  finalSettlementAmount Float
  paymentMode           String    @default("BANK_TRANSFER") // CASH, BANK_TRANSFER, UPI, CHEQUE
  bankAccountId         String?
  referenceNo           String?
  nocNumber             String?   @unique // e.g. "NOC-2026-0042"
  nocIssuedDate         DateTime?
  status                String    @default("COMPLETED") // DRAFT, PENDING_APPROVAL, COMPLETED
  approvedBy            String?
  remarks               String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  loan     Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model TaxInvoice {
  id                 String   @id @default(uuid())
  invoiceNumber      String   @unique // e.g. "INV-2026-001"
  invoiceDate        DateTime @default(now())
  customerId         String?
  customerName       String
  customerGstin      String?
  placeOfSupply      String   @default("33-Tamil Nadu")
  serviceType        String   // LOAN_PROCESSING_FEE, DOCUMENTATION_CHARGE, FORECLOSURE_CHARGE, PENAL_INTEREST, SERVICE_CHARGE
  sacCode            String   @default("997119") // SAC code for Financial Services
  taxableValue       Float
  gstRate            Float    @default(18.0)
  cgstAmount         Float    @default(0)
  sgstAmount         Float    @default(0)
  igstAmount         Float    @default(0)
  totalInvoiceAmount Float
  isMixedSupply      Boolean  @default(false)
  supplyCategory     String   @default("REGULAR") // REGULAR, COMPOSITE, MIXED
  status             String   @default("GENERATED") // GENERATED, FILED, CANCELLED
  createdAt          DateTime @default(now())

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
}

